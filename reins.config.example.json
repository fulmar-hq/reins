{
  "timezone": "America/Toronto",
  "defaultProvider": "codex",
  "providers": {
    "codex": { "enabled": true, "model": "gpt-6.2-sol", "effort": "medium", "args": [],
      "tiers": {
        "review": { "effort": "high" },
        "hard": { "model": "gpt-6.2-astra", "effort": "medium" },
        "bulk": { "model": "gpt-6.1-terra", "effort": "low" },
        "visual": { "model": "gpt-6.1-terra", "effort": "medium" }
      } },
    "claude": { "enabled": true, "model": "sonnet", "args": ["--permission-mode", "acceptEdits"],
      "tiers": { "hard": { "model": "opus" }, "bulk": { "model": "haiku" } } }
  },
  "caps": { "minutes": 60, "tokens": 500000, "silentMinutes": 10 },
  "notify": {
    "live": false,
    "owner": { "channel": "telegram", "credentialsFile": "/path/to/reins-private/telegram.json" },
    "coordinator": { "channel": "file" },
    "unansweredMinutes": 30,
    "ownerMaxPerDay": 4
  },
  "extraMeters": [
    { "name": "Cloud bill this month", "unit": "$", "limit": 100, "reset": "monthly", "everyHours": 4,
      "command": ["/path/to/reins-private/read-cloud-bill.sh"] }
  ],
  "backlog": { "label": "backlog", "command": ["printf", "%s\\n", "7"], "everyMinutes": 30 },
  "expiries": [
    { "name": "Cloud sign-in on this Mac", "recordFile": "/path/to/reins-private/cloud-signin-at", "hours": 24 }
  ],
  "page": { "port": 4319 },
  "privacyTermsFile": "/path/to/reins-private/private-words.txt"
}
